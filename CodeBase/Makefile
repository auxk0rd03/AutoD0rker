.PHONY: setup build run serve cli simulate test fmt clean

setup:
	@./dev.sh setup

build:
	@./dev.sh build

run:
	@./dev.sh run

serve:
	@./dev.sh serve

cli:
	@./dev.sh cli

simulate:
	@./dev.sh simulate

test:
	@./dev.sh test

fmt:
	@./dev.sh fmt

clean:
	@rm -rf bin/gateway bin/dork_spider crates/dork_spider/target
