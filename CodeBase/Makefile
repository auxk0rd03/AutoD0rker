.PHONY: setup build run serve status stop restart cli simulate test package fmt clean

setup:
	@./dev.sh setup

build:
	@./dev.sh build

run:
	@./dev.sh run

serve:
	@./dev.sh serve

status:
	@./dev.sh status

stop:
	@./dev.sh stop

restart:
	@./dev.sh restart

cli:
	@./dev.sh cli

simulate:
	@./dev.sh simulate

test:
	@./dev.sh test

package:
	@./dev.sh package

fmt:
	@./dev.sh fmt

clean:
	@rm -rf bin/gateway bin/dork_spider crates/dork_spider/target
